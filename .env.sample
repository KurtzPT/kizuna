# Kizuna settings file. Copy it to kizuna.env in the data folder
# (/data/kizuna.env in Docker), or point KIZUNA_CONFIG at it.
# One NAME=value per line; names are upper case (others are ignored).
# Environment variables (Docker, Compose) win over this file, even when set
# to "". A commented-out line shows the default.
# Details: SETTINGS.md.

# --------------------------------------------------------------------------
# Keys
# --------------------------------------------------------------------------
# Kizuna needs ANIDB_CLIENT or a TheTVDB key (one mode working is enough).

# AniDB HTTP client name (anidb.net > Settings > Client, protocol HTTP).
# Needed for /anidb (its episodes), plus summaries and specials.
ANIDB_CLIENT=

# Version you registered for that client. Number.
ANIDB_CLIENTVER=1

# TheTVDB v4 API key: needed for /tvdb (its episodes), plus thumbnails and
# artwork. Empty = off.
TVDB_API_KEY=

# TheTVDB subscriber PIN: needed for a free user-supported key, not a company key.
# TVDB_PIN=

# Legacy TheTVDB (v3) key: used when TVDB_API_KEY is empty or rejected.
# TVDB_LEGACY_API_KEY=

# TheMovieDb v3 API key: artwork, logos, details, episode titles. Empty = off.
TMDB_API_KEY=

# MyAnimeList API v2 Client ID (myanimelist.net/apiconfig). Empty = off.
MAL_CLIENT_ID=

# Your Plex server's address as Kizuna reaches it, and a Plex token. With
# both, the opening and ending extras Plex names "OP1", "NCED2"... get the
# titles "Opening 1", "Ending 2" (GUIDE.md, "Readable titles"). The token
# alone turns on the plex source: Plex's own metadata service (GUIDE.md,
# "Plex as a source").
# e.g. http://192.168.1.10:32400 (nothing after the port). Empty = off.
# PLEX_URL=
# PLEX_TOKEN=

# --------------------------------------------------------------------------
# Matching & titles
# --------------------------------------------------------------------------

# Lowest title-search score for an automatic match. 0-100.
# MIN_SCORE=80

# Rules /auto uses for a show without an AniDB or TVDB tag or GUID.
# anidb | tvdb
# AUTO_DEFAULT=anidb

# Id mapping lists, in priority order; later ones only fill missing ids.
# animelists, fribb
# MAPPING_SOURCES=animelists,fribb

# Show title language order. main (AniDB main title) or AniDB language
# codes: x-jat (romaji), en, ja, de...
# TITLE_LANGS=main,x-jat,en

# true = TITLE_LANGS skips AniDB synonyms (official titles only).
# true | false
# TITLE_OFFICIAL_ONLY=false

# Plex "original title" language order (official titles only).
# AniDB language codes | none (no original title)
# ORIGINAL_TITLE_LANGS=ja

# AniDB episode title language order. AniDB language codes.
# EPISODE_LANGS=en,x-jat

# --------------------------------------------------------------------------
# Sources per field
# --------------------------------------------------------------------------
# Comma-separated, first source with a value wins. none = field off.
# plex (Plex's metadata service) needs PLEX_TOKEN.

# Show title. anidb, tvdb, tmdb, plex, ann
# TITLE_SOURCES=anidb,tvdb,tmdb,plex,ann

# Summary. anidb, tvdb, tmdb, mal, plex, ann
# SUMMARY_SOURCES=anidb,tvdb,tmdb,mal,plex,ann

# Genres. anidb, tvdb, tmdb, mal, plex, ann
# GENRE_SOURCES=anidb,tvdb,tmdb,mal,plex,ann

# Cast (voice actors). anidb, tvdb, tmdb, plex, ann
# CAST_SOURCES=anidb,tvdb,tmdb,plex,ann

# Show directors and writers. anidb, tvdb, tmdb, plex, ann
# CREW_SOURCES=anidb,tvdb,tmdb,plex,ann

# Studio. anidb, tvdb, tmdb, mal, plex, ann
# STUDIO_SOURCES=anidb,tvdb,tmdb,mal,plex,ann

# First aired date. anidb, tvdb, tmdb, mal, plex, ann
# DATE_SOURCES=anidb,tvdb,tmdb,mal,plex,ann

# Content rating. anidb, tvdb, tmdb, mal, plex, ann
# RATING_SOURCES=anidb,tvdb,tmdb,mal,plex,ann

# Content rating country order. ISO country codes, e.g. DE or GB,US
# RATING_COUNTRY=US

# Posters. anidb, tvdb, tmdb, mal, plex, ann
# POSTER_SOURCES=tvdb,tmdb,anidb,mal,plex,ann

# Backgrounds. tvdb, tmdb, plex
# BACKGROUND_SOURCES=tvdb,tmdb,plex

# Clear logos. tvdb, tmdb, plex
# LOGO_SOURCES=tvdb,tmdb,plex

# true = artwork from every listed source (pick in Plex's Edit dialog);
# false = only the first source that has any. true | false
# ART_ALL_SOURCES=false

# Shows and Plex seasons get their TheTVDB/TheMovieDb season's art. A season
# without art of a kind: true = that site's series art; false = the next
# source. true | false
# SEASON_ART_FALLBACK=true

# Episode titles, both modes; first real title wins. anidb, tvdb, tmdb, plex
# EPISODE_TITLES=anidb,tvdb,tmdb,plex

# /anidb mode: episode thumbnails, plus summaries, dates and runtimes
# AniDB lacks; the first listed source with a value wins. tvdb, plex | none
# EPISODE_FILL_SOURCES=tvdb,plex

# --------------------------------------------------------------------------
# Server
# --------------------------------------------------------------------------

# Port to listen on. 1-65535. In Docker, leave it and change the host side
# of the port mapping instead ("32700:32600"); with host networking, set it here.
# PORT=32600

# Full listen address, overrides PORT. e.g. 127.0.0.1:32600 (local only)
# Not in Docker: 127.0.0.1 makes Kizuna unreachable from outside the container,
# and another port breaks the port mapping.
# Default: every address on PORT.
# LISTEN=:32600

# Cache, AniDB state, mapping corrections, logs, reports. A folder path.
# Set here it moves those, but not where this file is looked for.
# Not in Docker: the image always uses /data.
# DATA_DIR=./data

# --------------------------------------------------------------------------
# Access
# --------------------------------------------------------------------------

# Client addresses that may use Kizuna, comma-separated.
# private (LAN, Docker, Tailscale) | IPs | networks (192.168.1.0/24) | any
# ALLOW_FROM=private

# Extra names Kizuna is reached by, comma-separated. Always allowed: IPs,
# localhost, one-word names, and names ending in .local, .lan, .home,
# .home.arpa, .internal or .localdomain.
# kizuna.example.com | .example.com (or *.example.com) | any (or *)
# ALLOWED_HOSTS=

# --------------------------------------------------------------------------
# Storage & cache
# --------------------------------------------------------------------------

# Below this much free disk space, delete the oldest cache files...
# Size: 500MB, 2GB, 1.5TB (plain number = MB) | 0 = never clean up
# CACHE_MIN_FREE=1GB

# ...until this much is free. Size, at least CACHE_MIN_FREE.
# CACHE_FREE_TARGET=2GB

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------

# info | debug
# LOG_LEVEL=info

# Days of old log files kept. 0 or more | 0 (or 100000 and up) = keep forever
# LOG_RETENTION_DAYS=7

# Time zone for log timestamps and log days. e.g. Europe/London
# (UTC is the Docker image's default; the binary uses the system's time zone.)
# TZ=UTC

# true = write an HTML match report per show to reports/ in the data folder.
# true | false
# MATCH_REPORTS=false
