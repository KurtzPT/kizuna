# Kizuna settings file. Copy it to kizuna.env in the data folder
# (/data/kizuna.env in Docker), or point KIZUNA_CONFIG at it.
# One NAME=value per line. Environment variables (Docker, Compose) win over
# this file, even when set to "". A commented-out line shows the default.
# Details: SETUP.md > Settings.

# --------------------------------------------------------------------------
# Keys
# --------------------------------------------------------------------------

# AniDB HTTP client name (anidb.net > Settings > Client, protocol HTTP).
# Required for AniDB summaries, episodes and specials.
ANIDB_CLIENT=

# Version you registered for that client. Number.
ANIDB_CLIENTVER=1

# TheTVDB v4 API key: TVDB episodes, thumbnails, artwork. Empty = off.
TVDB_API_KEY=

# TheTVDB subscriber PIN, only for keys that need one.
# TVDB_PIN=

# Legacy TheTVDB (v3) key: used when TVDB_API_KEY is empty or rejected.
# TVDB_LEGACY_API_KEY=

# TheMovieDb v3 API key: artwork, logos, /tvdb episodes. Empty = off.
TMDB_API_KEY=

# MyAnimeList API v2 Client ID (myanimelist.net/apiconfig). Empty = off.
MAL_CLIENT_ID=

# --------------------------------------------------------------------------
# Matching & titles
# --------------------------------------------------------------------------

# Lowest title-search score for an automatic match. 0-100.
# MIN_SCORE=80

# Rules /auto uses for a show without an AniDB or TVDB tag or GUID.
# anidb | tvdb
# AUTO_DEFAULT=anidb

# Id mapping lists, in priority order; later ones only fill missing ids.
# animelists, fribb | none
# MAPPING_SOURCES=animelists,fribb

# Show title language order. main (AniDB main title) or AniDB language
# codes: x-jat (romaji), en, ja, de...
# TITLE_LANGS=main,x-jat,en

# true = TITLE_LANGS skips AniDB synonyms (official titles only).
# true | false
# TITLE_OFFICIAL_ONLY=false

# Plex "original title" language order (official titles only).
# AniDB language codes | none (no original title)
# ORIGINAL_TITLE_LANGS=ja

# AniDB episode title language order. AniDB language codes.
# EPISODE_LANGS=en,x-jat

# --------------------------------------------------------------------------
# Sources per field
# --------------------------------------------------------------------------
# Comma-separated, first source with a value wins. none = field off.

# Show title. anidb, tvdb, tmdb, ann
# TITLE_SOURCES=anidb,tvdb,tmdb,ann

# Summary. anidb, tvdb, tmdb, mal, ann
# SUMMARY_SOURCES=anidb,tvdb,tmdb,mal,ann

# Genres. anidb, tvdb, tmdb, mal, ann
# GENRE_SOURCES=anidb,tvdb,tmdb,mal,ann

# Cast (voice actors). anidb, tvdb, tmdb, ann
# CAST_SOURCES=anidb,tvdb,tmdb,ann

# Show directors and writers. anidb, tvdb, tmdb, ann
# CREW_SOURCES=anidb,tvdb,tmdb,ann

# Studio. anidb, tvdb, tmdb, mal, ann
# STUDIO_SOURCES=anidb,tvdb,tmdb,mal,ann

# First aired date. anidb, tvdb, tmdb, mal, ann
# DATE_SOURCES=anidb,tvdb,tmdb,mal,ann

# Content rating. anidb, tvdb, tmdb, mal, ann
# RATING_SOURCES=anidb,tvdb,tmdb,mal,ann

# Content rating country order. ISO country codes, e.g. DE or GB,US
# RATING_COUNTRY=US

# Posters. anidb, tvdb, tmdb, mal, ann
# POSTER_SOURCES=tvdb,tmdb,anidb,mal,ann

# Backgrounds. tvdb, tmdb
# BACKGROUND_SOURCES=tvdb,tmdb

# Clear logos. tvdb, tmdb
# LOGO_SOURCES=tvdb,tmdb

# true = artwork from every listed source (pick in Plex's Edit dialog);
# false = only the first source that has any. true | false
# ART_ALL_SOURCES=false

# /tvdb mode: where the episode list comes from. tvdb, tmdb
# EPISODE_SOURCES=tvdb,tmdb

# Episode titles, both modes; first real title wins. anidb, tvdb, tmdb
# EPISODE_TITLES=anidb,tvdb,tmdb

# /anidb mode: episode thumbnails, plus summaries, dates and runtimes
# AniDB lacks. tvdb | none
# EPISODE_FILL_SOURCES=tvdb

# --------------------------------------------------------------------------
# Server
# --------------------------------------------------------------------------

# Port to listen on. 1-65535. Not in Docker: the image sets PORT=32600,
# change the host side of the port mapping instead ("32700:32600").
# PORT=32600

# Full listen address, overrides PORT. e.g. 127.0.0.1:32600 (local only)
# In Docker, keep the port 32600 or the port mapping breaks.
# LISTEN=

# Cache, AniDB state, mapping corrections, logs, reports. A folder path.
# Set here it moves those, but not where this file is looked for.
# Not in Docker: the image always uses /data.
# DATA_DIR=./data

# --------------------------------------------------------------------------
# Access
# --------------------------------------------------------------------------

# Client addresses that may use Kizuna, comma-separated.
# private (LAN, Docker, Tailscale) | IPs | networks (192.168.1.0/24) | any
# ALLOW_FROM=private

# Extra names Kizuna is reached by, comma-separated. IPs, one-word names and
# .local/.lan/.home.arpa always work. kizuna.example.com | .example.com | any
# ALLOWED_HOSTS=

# --------------------------------------------------------------------------
# Storage & cache
# --------------------------------------------------------------------------

# Below this much free disk space, delete the oldest cache files...
# Size: 500MB, 2GB, 1.5TB (plain number = MB) | 0 = never clean up
# CACHE_MIN_FREE=1GB

# ...until this much is free. Size, at least CACHE_MIN_FREE.
# CACHE_FREE_TARGET=2GB

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------

# info | debug
# LOG_LEVEL=info

# Days of old log files kept. 0 or more | 0 = keep forever
# LOG_RETENTION_DAYS=7

# Time zone for log timestamps and log days. e.g. Europe/Lisbon (default UTC)
# TZ=

# true = write an HTML match report per show to reports/ in the data folder.
# true | false
# MATCH_REPORTS=false
